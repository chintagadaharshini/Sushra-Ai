# --- Required ---
DATABASE_URL="file:./dev.db"
# Long random string used to sign demo session cookies (HMAC-SHA256)
SESSION_SECRET="replace-with-a-long-random-string"

# --- Data mode ---
# local        -> records stored in this app's database (default)
# abdm_sandbox -> ABDM integration adapter (stub until you have approved sandbox credentials)
DATA_MODE="local"

# --- Optional ABDM sandbox (only after registering at https://sandbox.abdm.gov.in) ---
ABDM_BASE_URL=""
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""
ABDM_HIU_ID=""

# --- Optional LLM (server-side only; never exposed to the browser) ---
# When set, the assistant can (a) map unusual phrasings to validated intents and
# (b) produce richer report explanations — only after the user grants AI consent.
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-sonnet-5-5"

# --- Optional: Pipecat "Studio voice" agent (voice-agent/ folder) ---
VOICE_AGENT_URL="http://127.0.0.1:7860"
VOICE_AGENT_SHARED_SECRET=""
