# Sarvam AI — Saaras (speech-to-text) and Bulbul (text-to-speech). https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
# Groq — LLM for intent understanding + tool calling. https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Shared secret: only the signed-in Next.js app (which proxies /api/voice-agent/*) may start sessions.
# Must match VOICE_AGENT_SHARED_SECRET in the Next.js .env
VOICE_AGENT_SHARED_SECRET=HYWU6t_4iR430jfm0QRuHonoWBbYeIDkwqd9h115175Spn2nUBOMFaKWq9j1hrLk
STT_MODEL=saaras:v4
# Bulbul v3 female voices: priya, ritu, neha, pooja, simran, kavya, ishita, shreya, roopa
TTS_VOICE=priya
# 1 = let users interrupt the assistant (use with headphones). Default 0 mutes the mic while it speaks,
# which stops the assistant hearing its own voice through laptop/phone speakers.
STUDIO_BARGE_IN=0
TTS_MODEL=bulbul:v3
HOST=127.0.0.1
PORT=7860
